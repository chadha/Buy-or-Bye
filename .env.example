# Price data: "demo" (fictional, offline) or "idealo" (the real MCP server)
PRICE_SOURCE=demo
# Defaults follow github.com/idealo/mcp-server-guide; override only if idealo renames tools.
IDEALO_MCP_URL=https://mcp.idealo.com/mcp
IDEALO_COUNTRY=DE
# IDEALO_TOOL_SEARCH=search_products
# IDEALO_TOOL_HISTORY=get_product_price_history
# IDEALO_TOOL_OFFERS=get_product_offers
# IDEALO_TOOL_DETAILS=get_product_details
# Daily idealo call budget (UTC day). 500 is the Trial quota and the hard maximum.
# IDEALO_DAILY_LIMIT=500
# Calls kept for price checks: product details are refused once fewer than this are left.
# IDEALO_PRICE_CHECK_RESERVE=150
# IDEALO_DETAILS_TTL_S=86400
# IDEALO_USAGE_FILE=~/.buyorbye/idealo_usage.json
# Sign in once with `make idealo-login`; the token is cached in ~/.buyorbye/ (never commit it).

# Photo reading: any OpenAI-compatible endpoint with a vision model (e.g. Nebius)
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_VISION_MODEL=
